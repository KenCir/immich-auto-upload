<Window x:Class="ImmichDesktopUploader.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:ImmichDesktopUploader.Views"
 Title="Immich Desktop Uploader">
 <ContentControl x:Name="InteractionContainer" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Grid x:Name="Root" Padding="28" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources><views:ErrorSeverityConverter x:Key="ErrorSeverity"/><views:BooleanVisibilityConverter x:Key="BoolVisibility"/></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="6">
   <TextBlock Text="Immich Desktop Uploader" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.AutomationId="MainViewTitle"/>
   <TextBlock Text="写真フォルダの自動アップロード" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
  <Border Grid.Row="1" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="5">
     <TextBlock Text="Server" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding ServerUrl}" TextWrapping="Wrap" AutomationProperties.AutomationId="ServerUrl"/>
     <TextBlock Text="{Binding CredentialText}" AutomationProperties.AutomationId="CredentialState"/>
     <TextBlock Text="{Binding ConnectionText}" AutomationProperties.AutomationId="ConnectionState"/>
     <TextBlock Text="{Binding ConnectionCheckedText}" AutomationProperties.AutomationId="ConnectionLastChecked"/>
     <TextBlock Text="{Binding ManagerText}" AutomationProperties.AutomationId="ManagerState" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock Text="{Binding StartupText}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"/>
     <Button Content="{Binding PauseLabel}" Command="{Binding PauseResumeCommand}"/>
     <Button Content="Settings" Command="{Binding SettingsCommand}" AutomationProperties.AutomationId="SettingsButton"/>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Spacing="8">
   <InfoBar x:Name="LifetimeError" IsClosable="False" Severity="Error"/>
   <InfoBar IsOpen="{Binding HasGlobalError}" IsClosable="False" Severity="Error" Message="{Binding GlobalError}" AutomationProperties.AutomationId="GlobalError"/>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Content="Restore backup" Command="{Binding RestoreCommand}" Visibility="{Binding CanRestore, Converter={StaticResource BoolVisibility}}"/>
    <Button Content="Open settings folder" Command="{Binding OpenFolderCommand}"/>
    <Button Content="Exit application" Click="OnExit" AutomationProperties.AutomationId="ExitButton"/>
   </StackPanel>
  </StackPanel>
  <Grid Grid.Row="3" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="Upload folders" Style="{ThemeResource SubtitleTextBlockStyle}"/>
   <ListView Grid.Row="1" ItemsSource="{Binding Folders}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="FolderList">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate>
     <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="FolderDisplayName"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"/>
       </Grid>
       <TextBlock Text="{Binding Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
       <TextBlock Text="{Binding Album}"/>
       <TextBlock Text="{Binding EnabledText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <StackPanel Orientation="Horizontal" Spacing="20"><TextBlock Text="{Binding Activity}"/><TextBlock Text="{Binding Retry}"/></StackPanel>
       <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="{Binding IsError, Converter={StaticResource ErrorSeverity}}" Message="{Binding Error}"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}"/>
        <Button Content="Restart" Command="{Binding RestartCommand}"/>
        <Button Content="Edit" Command="{Binding EditCommand}"/>
        <Button Content="Remove" Command="{Binding RemoveCommand}"/>
        <ProgressRing IsActive="{Binding RestartCommand.IsBusy}" Width="20" Height="20"/>
        <ProgressRing IsActive="{Binding RemoveCommand.IsBusy}" Width="20" Height="20"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Content="＋ Add folder" Command="{Binding AddCommand}" AutomationProperties.AutomationId="AddFolderButton"/>
   <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Text="Runningはプロセス稼働状態です。サーバー接続・アップロード成功を保証しません。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Grid>
 </Grid>
 </ContentControl>
</Window>
